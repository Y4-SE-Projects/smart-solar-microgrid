<?xml version="1.0" encoding="utf-8"?>
<!-- Operator dashboard: identity, primary scan, quick operations, station, today's slots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface_container_lowest" android:gravity="center_vertical"
        android:minHeight="72dp" android:orientation="horizontal" android:paddingStart="16dp"
        android:paddingTop="8dp" android:paddingEnd="4dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/operatorInitialsText" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_icon_tile" android:fontFamily="sans-serif-medium"
            android:gravity="center" android:importantForAccessibility="no"
            android:textColor="@color/primary" android:textSize="14sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:text="@string/operator_title"
                android:textColor="@color/on_surface" android:textSize="18sp" />
            <TextView android:id="@+id/operatorNameText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/on_surface_variant" android:textSize="12sp" />
            <TextView android:id="@+id/operatorRoleText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:text="@string/operator_role" android:textColor="@color/secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/signOutButton"
            style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp"
            android:layout_height="48dp" android:contentDescription="@string/home_sign_out"
            app:icon="@drawable/ic_logout" app:iconTint="@color/on_surface_variant" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_slate" />

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp"
            android:paddingEnd="16dp" android:paddingBottom="28dp">

            <!-- Primary scan action remains usable while station data loads. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_scanner_panel" android:gravity="center_vertical"
                android:orientation="horizontal" android:padding="14dp">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_tile">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:importantForAccessibility="no"
                        android:src="@drawable/ic_qr_scanner" app:tint="@color/secondary" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" android:text="@string/home_verify_title"
                        android:textColor="@color/on_primary" android:textSize="16sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/home_verify_body"
                        android:textColor="@color/banner_text_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/openScannerButton"
                style="@style/Widget.SmartSolar.PrimaryButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="52dp"
                android:text="@string/home_verify_action" app:icon="@drawable/ic_qr_scanner"
                app:iconGravity="textStart" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/operator_quick_operations"
                android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
            <!-- Manage Slots is disabled until a station is selected; Recent Scans stays available. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/manageSlotsButton"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false"
                    android:minHeight="52dp" android:text="@string/manage_slots"
                    app:cornerRadius="10dp" app:icon="@drawable/ic_calendar"
                    app:iconTint="@color/secondary" app:strokeColor="@color/border_slate" />
                <com.google.android.material.button.MaterialButton android:id="@+id/recentScansButton"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1"
                    android:minHeight="52dp" android:text="@string/home_recent_scans_action"
                    android:textColor="@color/primary" app:cornerRadius="10dp" app:icon="@drawable/ic_schedule"
                    app:iconTint="@color/secondary" app:strokeColor="@color/border_slate" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/operator_station_title"
                android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/stationsProgress" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:indeterminate="true" android:visibility="gone"
                app:indicatorColor="@color/secondary" app:trackColor="@color/surface_container" />
            <LinearLayout android:id="@+id/stationsErrorBanner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@drawable/bg_error_banner" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp"
                android:visibility="gone">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_error"
                    app:tint="@color/on_error_container" />
                <TextView android:id="@+id/stationsErrorText" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textColor="@color/on_error_container" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/stationsRetryButton"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:text="@string/retry" />
            </LinearLayout>
            <TextView android:id="@+id/stationsEmptyText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/bg_operator_card" android:padding="16dp"
                android:text="@string/station_none" android:textColor="@color/on_surface_variant"
                android:textSize="13sp" android:visibility="gone" />

            <LinearLayout android:id="@+id/stationContent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <!-- Station name, ID and state are grouped before operational data. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_operator_card"
                    android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/stationNameText" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                                android:textColor="@color/on_surface" android:textSize="18sp" />
                            <TextView android:id="@+id/headerStationText" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                                android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/stationStatusChip"
                            style="@style/Widget.SmartSolar.StatusChip" android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="12dp" android:layout_marginBottom="10dp"
                        android:background="@color/border_slate" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/station_hours" android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                            <TextView android:id="@+id/stationHoursText" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                                android:fontFamily="sans-serif-medium" android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/station_capacity" android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                            <TextView android:id="@+id/stationCapacityText" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                                android:fontFamily="sans-serif-medium" android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/station_battery_slots" android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                            <TextView android:id="@+id/stationBatteryText" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                                android:fontFamily="sans-serif-medium" android:textColor="@color/on_surface"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/stationSwitcher"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:layout_marginTop="4dp" android:enabled="false"
                        android:text="@string/change_station" android:textColor="@color/secondary"
                        app:icon="@drawable/ic_expand_more" />
                </LinearLayout>

                <TextView android:id="@+id/deactivatedNotice" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_error_banner" android:padding="12dp"
                    android:textColor="@color/on_error_container" android:textSize="13sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/operator_today_operations"
                        android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                    <TextView android:id="@+id/todayDateText" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_operator_card"
                    android:orientation="horizontal" android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/metricAvailableText" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/metric_empty"
                            android:textAppearance="@style/TextAppearance.SmartSolar.Metric"
                            android:textColor="@color/secondary" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/metric_available" android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/metricUnavailableText" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/metric_empty"
                            android:textAppearance="@style/TextAppearance.SmartSolar.Metric"
                            android:textColor="@color/alert_danger" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/metric_unavailable" android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/metricTotalText" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/metric_empty"
                            android:textAppearance="@style/TextAppearance.SmartSolar.Metric"
                            android:textColor="@color/primary" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/metric_total" android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/today_schedule"
                        android:textAppearance="@style/TextAppearance.SmartSolar.Title" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/refreshSlotsButton"
                        style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp"
                        android:layout_height="48dp" android:contentDescription="@string/refresh"
                        app:icon="@drawable/ic_refresh" app:iconTint="@color/on_surface_variant" />
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/slotsProgress" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone"
                    app:indicatorColor="@color/secondary" app:trackColor="@color/surface_container" />
                <LinearLayout android:id="@+id/slotsErrorBanner" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/bg_error_banner"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingStart="12dp" android:paddingEnd="4dp" android:visibility="gone">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:importantForAccessibility="no" android:src="@drawable/ic_error"
                        app:tint="@color/on_error_container" />
                    <TextView android:id="@+id/slotsErrorText" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:textColor="@color/on_error_container" android:textSize="13sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/slotsRetryButton"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:text="@string/retry" />
                </LinearLayout>
                <TextView android:id="@+id/slotsEmptyText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_operator_card" android:drawableStart="@drawable/ic_schedule"
                    android:drawablePadding="10dp" android:drawableTint="@color/secondary"
                    android:gravity="center_vertical" android:padding="16dp" android:text="@string/slots_empty_today"
                    android:textColor="@color/on_surface_variant" android:textSize="13sp" android:visibility="gone" />
                <LinearLayout android:id="@+id/todaySlotsContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_operator_card" android:divider="@drawable/divider_slate"
                    android:orientation="vertical" android:showDividers="middle" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

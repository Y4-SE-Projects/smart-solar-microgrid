<?xml version="1.0" encoding="utf-8"?>
<!-- One reservation card on the Recent Scans screen: a header (tap to expand/collapse) plus
     that reservation's attempts, added as children of attemptsContainer in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/scanGroupHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/groupStatusIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/groupReservationIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/groupAttemptCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/groupLatestResultChip"
            style="@style/Widget.SmartSolar.StatusChip"
            android:layout_marginStart="8dp" />

        <ImageView
            android:id="@+id/groupChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>

    <View
        android:id="@+id/groupDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_slate"
        android:visibility="gone" />

    <!-- item_scan_attempt rows are added here in code, one per attempt, while expanded -->
    <LinearLayout
        android:id="@+id/attemptsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/divider_slate"
        android:orientation="vertical"
        android:showDividers="middle"
        android:visibility="gone" />
</LinearLayout>

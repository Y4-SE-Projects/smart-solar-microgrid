<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the "Deactivate your account?" confirmation on the profile screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/deactivate_body"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/reasonInput"
            android:text="@string/deactivate_label_reason"
            android:textAppearance="@style/TextAppearance.SmartSolar.FieldLabel" />

        <!-- The API limits the reason to 500 characters; the counter just shows how close the user is -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/reasonLayout"
            style="@style/Widget.SmartSolar.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:counterEnabled="true"
            app:counterMaxLength="500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/reasonInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/deactivate_hint_reason"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:maxLines="4"
                android:minLines="2"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/dialogErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_error_banner"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error"
                app:tint="@color/on_error_container" />

            <TextView
                android:id="@+id/dialogErrorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/on_error_container"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

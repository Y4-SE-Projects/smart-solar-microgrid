<?xml version="1.0" encoding="utf-8"?>
<!-- Compact slot row: time and switch above metadata and visible availability state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="78dp" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingTop="6dp"
    android:paddingEnd="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/slotTextColumn" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/slotDateText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-medium" android:textColor="@color/secondary"
                android:textSize="11sp" android:visibility="gone" />
            <TextView android:id="@+id/slotTimeText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum" android:textColor="@color/on_surface"
                android:textSize="16sp" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/slotSwitch"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:minWidth="48dp" android:minHeight="48dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/slotMetaText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:fontFeatureSettings="tnum" android:maxLines="1"
            android:textColor="@color/on_surface_variant" android:textSize="12sp" />
        <TextView android:id="@+id/slotStatusChip" style="@style/Widget.SmartSolar.StatusChip"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container_lowest"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/on_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/history_title"
                android:textColor="@color/on_surface"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/history_subtitle"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_slate" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.SmartSolar.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/historySearchInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/history_search_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tune"
            app:tint="@color/on_surface_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/history_filter_label"
            android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="7dp"
        android:paddingBottom="14dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/statusFilterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filterAllChip"
                style="@style/Widget.SmartSolar.HistoryFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterPendingChip"
                style="@style/Widget.SmartSolar.HistoryFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reservation_status_pending" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterApprovedChip"
                style="@style/Widget.SmartSolar.HistoryFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reservation_status_approved" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCompletedChip"
                style="@style/Widget.SmartSolar.HistoryFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reservation_status_completed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterDeclinedChip"
                style="@style/Widget.SmartSolar.HistoryFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reservation_status_declined" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCancelledChip"
                style="@style/Widget.SmartSolar.HistoryFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reservation_status_cancelled" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterExpiredChip"
                style="@style/Widget.SmartSolar.HistoryFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reservation_status_expired" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_slate" />

    <LinearLayout
        android:id="@+id/historySyncBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/historySyncIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_refresh"
            app:tint="@color/secondary" />

        <TextView
            android:id="@+id/historySyncText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/historySyncRetryButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/historySyncProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/historyLoadingView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="18dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                app:indicatorColor="@color/secondary"
                app:indicatorSize="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/history_loading"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/historyStateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/border_slate"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <ImageView
                    android:id="@+id/historyStateIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_tile"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/secondary" />

                <TextView
                    android:id="@+id/historyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/historyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryHistoryButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/retry"
                    android:textColor="@color/primary"
                    android:visibility="gone"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/secondary"
                    app:strokeColor="@color/border_slate" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <com.example.smart_solar_mobile.views.ProsumerBottomNavigation
        android:id="@+id/prosumerBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>

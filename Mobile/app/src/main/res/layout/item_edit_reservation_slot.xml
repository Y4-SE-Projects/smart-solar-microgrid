<?xml version="1.0" encoding="utf-8"?>
<!-- A live edit choice: either the reservation's current owned slot or an available replacement. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="108dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_slate"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar"
                app:tint="@color/secondary" />

            <TextView
                android:id="@+id/editSlotDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/editSlotSelected"
                style="@style/Widget.SmartSolar.StatusChip"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_active"
                android:text="@string/reservation_selected"
                android:textColor="@color/primary_container"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/editSlotTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/primary"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editSlotId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/editSlotKind"
                style="@style/Widget.SmartSolar.StatusChip"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_neutral"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_slate" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:id="@+id/prosumerNavHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="50dp"
            android:minWidth="56dp"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/prosumerNavHomeIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_prosumer_nav_icon_surface"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_home"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/prosumerNavHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/prosumer_nav_home"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prosumerNavStations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="50dp"
            android:minWidth="56dp"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/prosumerNavStationsIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_prosumer_nav_icon_surface"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_prosumer_nav_station"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/prosumerNavStationsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/prosumer_nav_stations"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prosumerNavBookings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="50dp"
            android:minWidth="56dp"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/prosumerNavBookingsIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_prosumer_nav_icon_surface"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/prosumerNavBookingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/prosumer_nav_bookings"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prosumerNavProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="50dp"
            android:minWidth="56dp"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/prosumerNavProfileIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_prosumer_nav_icon_surface"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/prosumerNavProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/prosumer_nav_profile"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</merge>

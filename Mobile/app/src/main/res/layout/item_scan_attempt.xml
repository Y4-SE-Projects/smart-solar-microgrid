<?xml version="1.0" encoding="utf-8"?>
<!-- One scan attempt, indented under its reservation group header -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container_low"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/attemptAtText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/attemptResultChip"
            style="@style/Widget.SmartSolar.StatusChip"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/attemptReasonText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>

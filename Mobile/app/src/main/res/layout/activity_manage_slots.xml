<?xml version="1.0" encoding="utf-8"?>
<!-- Grid Operator workflow: choose station, choose date, then manage that day's slots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manageRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:background="@color/surface_container_lowest" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp"
            android:layout_height="48dp" android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back" app:iconTint="@color/on_surface" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:text="@string/manage_slots"
                android:textColor="@color/on_surface" android:textSize="17sp" />
            <TextView android:id="@+id/headerStationText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/on_surface_variant" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_slate" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp"
            android:paddingEnd="16dp" android:paddingBottom="28dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/operator_station_title"
                android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_operator_card"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/bg_icon_tile">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="center" android:importantForAccessibility="no"
                        android:src="@drawable/ic_bolt" app:tint="@color/secondary" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/stationNameValueText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                        android:maxLines="2" android:ellipsize="end"
                        android:textColor="@color/on_surface" android:textSize="16sp" />
                    <TextView android:id="@+id/stationIdValueText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/stationSwitcher"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:enabled="false"
                    android:text="@string/change_station" />
            </LinearLayout>
            <LinearLayout android:id="@+id/stationsErrorBanner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/bg_error_banner" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp"
                android:visibility="gone">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_error"
                    app:tint="@color/on_error_container" />
                <TextView android:id="@+id/stationsErrorText" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textColor="@color/on_error_container" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/stationsRetryButton"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:text="@string/retry" />
            </LinearLayout>
            <TextView android:id="@+id/deactivatedNotice" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/bg_error_banner" android:padding="12dp"
                android:textColor="@color/on_error_container" android:textSize="13sp" android:visibility="gone" />

            <!-- Date context is always visible; the existing calendar expands in place. -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/operator_choose_date"
                android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_operator_card"
                android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/operator_selected_date"
                            android:textAppearance="@style/TextAppearance.SmartSolar.Overline" />
                        <TextView android:id="@+id/selectedDateText" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium" android:textColor="@color/on_surface"
                            android:textSize="17sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/todayButton"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:text="@string/today" android:textColor="@color/primary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/calendarToggleButton"
                        style="@style/Widget.SmartSolar.ToggleIconButton" android:layout_width="48dp"
                        android:layout_height="48dp" android:layout_marginStart="4dp"
                        android:contentDescription="@string/show_calendar" app:icon="@drawable/ic_calendar" />
                </LinearLayout>
                <LinearLayout android:id="@+id/calendarCard" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:orientation="vertical" android:visibility="gone">
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginBottom="8dp" android:background="@color/border_slate" />
                    <com.example.smart_solar_mobile.views.MonthCalendarView android:id="@+id/calendarView"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center_vertical"
                        android:minHeight="40dp" android:orientation="horizontal">
                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="@drawable/bg_legend_marked" />
                        <TextView android:id="@+id/legendText" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_marginStart="6dp"
                            android:layout_weight="1" android:text="@string/legend_has_slots"
                            android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                        <TextView android:id="@+id/monthStatusText" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
                            android:fontFeatureSettings="tnum" android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Slot list and search now follow the selected station and date. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/listTitleText" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end"
                    android:maxLines="1" android:textAppearance="@style/TextAppearance.SmartSolar.Title"
                    android:textSize="16sp" />
                <TextView android:id="@+id/listCountText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:accessibilityLiveRegion="polite" android:fontFeatureSettings="tnum"
                    android:textColor="@color/on_surface_variant" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/slotSearchLayout"
                style="@style/Widget.SmartSolar.TextField" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                app:endIconMode="clear_text" app:startIconDrawable="@drawable/ic_search">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/slotSearchInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:imeOptions="actionSearch" android:importantForAutofill="no"
                    android:inputType="text" android:maxLines="1" android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:id="@+id/actionErrorBanner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/bg_error_banner" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp"
                android:visibility="gone">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_error"
                    app:tint="@color/on_error_container" />
                <TextView android:id="@+id/actionErrorText" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:layout_weight="1" android:accessibilityLiveRegion="polite"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textColor="@color/on_error_container" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/actionErrorDismissButton"
                    style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp"
                    android:layout_height="48dp" android:contentDescription="@string/dismiss"
                    app:icon="@drawable/ic_close" app:iconTint="@color/on_error_container" />
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/slotsProgress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:indeterminate="true" android:visibility="gone"
                app:indicatorColor="@color/secondary" app:trackColor="@color/surface_container" />
            <LinearLayout android:id="@+id/slotsErrorBanner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/bg_error_banner" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp"
                android:visibility="gone">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_error"
                    app:tint="@color/on_error_container" />
                <TextView android:id="@+id/slotsErrorText" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textColor="@color/on_error_container" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/slotsRetryButton"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:text="@string/retry" />
            </LinearLayout>
            <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/bg_operator_card" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="18dp" android:visibility="gone">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginBottom="8dp" android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" app:tint="@color/secondary" />
                <TextView android:id="@+id/emptyTitleText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:gravity="center" android:textColor="@color/on_surface" android:textSize="14sp" />
                <TextView android:id="@+id/emptyMessageText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                    android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/clearSearchButton"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/clear_search"
                    android:textColor="@color/primary" android:visibility="gone"
                    app:cornerRadius="10dp" app:strokeColor="@color/border_slate" />
            </LinearLayout>
            <LinearLayout android:id="@+id/slotsContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="@drawable/bg_operator_card" android:divider="@drawable/divider_slate"
                android:orientation="vertical" android:showDividers="middle" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the "Account deactivated" / "Reactivation pending" dialogs on the login screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/dialogBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <!-- Shown when Backoffice deactivated the account, with its reason or "No reason was given." -->
        <LinearLayout
            android:id="@+id/backofficeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_danger"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/deactivated_by_backoffice_label"
                android:textAppearance="@style/TextAppearance.SmartSolar.Overline"
                android:textColor="@color/alert_danger" />

            <TextView
                android:id="@+id/backofficeReasonText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Shown whenever Backoffice declined the last request, with its reason or "No reason was given." -->
        <LinearLayout
            android:id="@+id/declinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_warning"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/deactivated_declined_label"
                android:textAppearance="@style/TextAppearance.SmartSolar.Overline"
                android:textColor="@color/alert_warning" />

            <TextView
                android:id="@+id/declinedReasonText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dialogErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_error_banner"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error"
                app:tint="@color/on_error_container" />

            <TextView
                android:id="@+id/dialogErrorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/on_error_container"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
